# Privy App ID is public client configuration.
# Never put a Privy app secret, wallet secret, seed phrase, or private key here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Zero Hash — server only. Start in Cert.
ZERO_HASH_ENV=cert
ZERO_HASH_API_KEY=
ZERO_HASH_API_SECRET=
ZERO_HASH_PASSPHRASE=

# Marqeta — sandbox only for now. Server-side only.
MARQETA_BASE_URL=https://sandbox-api.marqeta.com/v3
MARQETA_APPLICATION_TOKEN=
MARQETA_ADMIN_ACCESS_TOKEN=
